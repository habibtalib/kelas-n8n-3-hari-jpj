    "sendTo": "={{ $json['E-mel'] }}",
    "subject": "=Permohonan Tajaan Diterima — {{ $json['Nama Syarikat'] }}",
    "message": "=Salam sejahtera {{ $json['Nama Kontak'] }},\n\nTerima kasih atas permohonan tajaan daripada {{ $json['Nama Syarikat'] }} (bajet: RM{{ $json['Bajet (RM)'] }}).\n\nPermohonan anda memenuhi kriteria dan pasukan kami akan menghubungi anda dalam 3 hari bekerja.\n\nSekian, terima kasih.",
    "options": {
     "appendAttribution": false
    }
   }
