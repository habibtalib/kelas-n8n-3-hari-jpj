    "content": "## 📝 Automasi 2 — Sponsorship Intake\nForm → IF (bajet?) → Gmail (auto-reply) → Google Sheets (log).\n(Switch dalam video = IF di sini untuk 2 cabang)",
    "width": 560,
    "height": 170,
    "color": 4
   }
  },
  {
   "id": "n1",
   "name": "On form submission",
   "type": "n8n-nodes-base.formTrigger",
   "typeVersion": 2,
   "position": [
    0,
    0
   ],
   "parameters": {
    "formTitle": "Borang Permohonan Tajaan (Contoh)",
    "formDescription": "Isi butiran syarikat & bajet tajaan.",
    "formFields": {
     "values": [
      {
       "fieldLabel": "Nama Syarikat",
       "fieldType": "text",
       "requiredField": true
      },
      {
       "fieldLabel": "Nama Kontak",
       "fieldType": "text"
      },
      {
       "fieldLabel": "E-mel",
       "fieldType": "email",
       "requiredField": true
      },
      {
       "fieldLabel": "Bajet (RM)",
       "fieldType": "number",
       "requiredField": true
      },
      {
       "fieldLabel": "Nota",
       "fieldType": "textarea"
      }
     ]
    },
    "responseMode": "onReceived",
    "options": {
     "formSubmittedText": "Terima kasih! Permohonan tajaan anda telah diterima."
    }
   }
  },
  {
   "id": "n2",
   "name": "If (budget check)",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    280,
    0
   ],
   "parameters": {
    "conditions": {
     "options": {
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json['Bajet (RM)'] }}",
       "rightValue": 100000,
       "operator": {
        "type": "number",
        "operation": "gte"
       }
      }
     ],
     "combinator": "and"
    }
   }
  },
  {
   "id": "n3",
   "name": "Gmail — Follow-up",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2,
