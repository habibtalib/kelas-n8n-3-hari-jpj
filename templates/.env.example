# =============================================================================
# Contoh fail persekitaran (.env) — Pembantu Pintar JPJ (RAG-N8N-JPJ-101)
# -----------------------------------------------------------------------------
# CARA GUNA:
#   1. Salin fail ini:  cp .env.example .env
#   2. Ubah kata laluan di bawah kepada nilai anda sendiri (JANGAN guna default!).
#   3. Fail .env dibaca automatik oleh 'docker compose up -d'.
#
# ⚠️ JANGAN commit fail .env sebenar ke git — ia mengandungi rahsia.
# =============================================================================

# --- PostgreSQL (pangkalan data dalaman n8n) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_password_change_me
POSTGRES_DB=n8n

# --- Log masuk asas n8n (basic auth ke editor http://localhost:5678) ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin_change_me

# --- Tetapan umum n8n ---
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kuala_Lumpur

# --- (Pilihan) Kunci penyulitan credentials n8n ---
# Tetapkan satu rentetan rawak tetap supaya credentials boleh dibaca semula
# selepas restart. Jana contohnya dengan:  openssl rand -hex 24
# N8N_ENCRYPTION_KEY=

# --- Kunci API OpenAI (dimasukkan dalam n8n Credentials, bukan diperlukan di sini) ---
# Simpan kunci OpenAI anda dalam UI n8n (Credentials > OpenAI). Baris ini hanya
# peringatan — anda tidak perlu letak kunci sebenar dalam fail ini.
# OPENAI_API_KEY=sk-...

# --- (Pilihan) Ollama on-premise ---
# Jika perkhidmatan 'ollama' dihidupkan dalam docker-compose.yml, dalam n8n
# gunakan Base URL:  http://ollama:11434
# OLLAMA_BASE_URL=http://ollama:11434
